`timescale 1ns/1ps

module tb_fir32_lowpass;

    reg clk;
    reg rst_n;
    reg signed [7:0] x_in;
    wire signed [23:0] y_out;

    // Goi bo loc FIR can kiem tra
    fir32_lowpass uut (
        .clk(clk),
        .rst_n(rst_n),
        .x_in(x_in),
        .y_out(y_out)
    );

    // Tao xung clock chu ky 10 ns
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    // Tao tin hieu kiem tra
    initial begin
        rst_n = 0;
        x_in = 0;

        // Giu reset trong 20 ns
        #20;
        rst_n = 1;

        // Dua mau vao tung chu ky clock
        #10; x_in =  20;
        #10; x_in =  45;
        #10; x_in =  60;
        #10; x_in =  35;
        #10; x_in =   0;
        #10; x_in = -25;
        #10; x_in = -40;
        #10; x_in = -15;
        #10; x_in =  10;
        #10; x_in =  30;
        #10; x_in =  15;
        #10; x_in =   0;
        #10; x_in = -20;
        #10; x_in = -10;
        #10; x_in =  10;
        #10; x_in =  25;

        #50;
        $stop;
    end

    // In ket qua ra ModelSim Transcript
    initial begin
        $monitor("time=%0t ns | x_in=%0d | y_out=%0d",
                 $time, x_in, y_out);
    end

endmodule

